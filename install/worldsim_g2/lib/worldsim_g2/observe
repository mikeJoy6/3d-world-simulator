#!/usr/bin/python3
"""Republish G2 observations with their original timestamps."""
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from geometry_msgs.msg import PoseStamped
from sensor_msgs.msg import CompressedImage, Image, JointState

class G2Observer(Node):
    def __init__(self):
        super().__init__('g2_observe')
        from gdk_msgs.msg import JointState as GdkJointState, MotionControlStatus
        qos = qos_profile_sensor_data
        for kind, src, out in [(CompressedImage, 'camera/head_color', 'color/compressed'),
                               (Image, 'camera/head_depth', 'depth')]:
            publisher = self.create_publisher(kind, '/worldsim/g2/'+out, qos)
            self.create_subscription(kind, '/gdk/'+src, publisher.publish, qos)
        self.joints = self.create_publisher(JointState, '/worldsim/g2/joint_states', qos)
        self.poses = {frame:self.create_publisher(PoseStamped, '/worldsim/g2/'+side+'_pose', qos)
                      for frame,side in [('arm_l_end_link','left'),('arm_r_end_link','right')]}
        self.create_subscription(GdkJointState, '/gdk/joint_state', self.on_joints, qos)
        self.create_subscription(MotionControlStatus, '/gdk/motion_control_status', self.on_status, qos)
        self.get_logger().info('Listening for G2 observations.')

    def on_joints(self, msg):
        self.joints.publish(JointState(header=msg.header, name=msg.name, position=msg.position,
                                       velocity=msg.velocity, effort=msg.effort))

    def on_status(self, msg):
        for name, pose in zip(msg.frame_names, msg.frame_poses):
            if name in self.poses:
                self.poses[name].publish(PoseStamped(header=msg.header, pose=pose))

if __name__ == '__main__':
    rclpy.init()
    node = G2Observer()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()
