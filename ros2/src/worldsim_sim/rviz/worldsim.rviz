Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 34; 38
    Fixed Frame: worldsim_world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Plane Cell Count: 12
      Cell Size: 0.1
      Color: 90; 94; 100
      Offset: {X: 0, Y: 0, Z: -0.076}
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (URDF)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
        History Policy: Keep Last
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Scene particles
      Enabled: true
      Topic:
        Value: /worldsim/points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
        History Policy: Keep Last
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Flat Squares
      Size (m): 0.004
      Value: true
    - Class: rviz_default_plugins/Camera
      Name: Model camera
      Enabled: true
      Topic:
        Value: /worldsim/image
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
        History Policy: Keep Last
      Image Rendering: background and overlay
      Overlay Alpha: 0.6
      Zoom Factor: 1
      Visibility:
        Grid: false
        Robot (URDF): true
        Scene particles: false
        MotionPlanning: false
        Model's belief of the arms: false
        Value: true
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Scene Geometry:
        Scene Alpha: 0.9
        Show Scene Geometry: true
      Scene Robot:
        Show Robot Visual: false
        Show Robot Collision: false
        Robot Alpha: 1
      Planning Request:
        Planning Group: arm0
        Interactive Marker Size: 0.12
        Query Start State: false
        Query Goal State: true
        Goal State Alpha: 0.6
        Colliding Link Color: 255; 0; 0
        Joint Violation Color: 255; 0; 255
      Planned Path:
        Show Robot Visual: true
        Show Trail: false
        Loop Animation: false
        Robot Alpha: 0.4
        State Display Time: 0.05 s
        Trajectory Topic: /display_planned_path
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Model's belief of the arms
      Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
        History Policy: Keep Last
      TF Prefix: model
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.35
      Value: false
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: <Fixed Frame>
      Distance: 1.6
      Pitch: 0.75
      Yaw: 4.6
      Focal Point: {X: 0, Y: 0.0, Z: -0.05}
Window Geometry:
  Width: 1500
  Height: 900
