#!/usr/bin/python3
"""Terminal keyboard for the end-effector control (ee_teleop moves the arms through MoveIt; the model follows)."""
import select
import sys
import termios
import tty
import rclpy
from rclpy.node import Node
from std_msgs.msg import Empty, String

def main():
    if not sys.stdin.isatty():
        raise SystemExit('Run the keyboard in an interactive terminal.')
    rclpy.init()
    node = Node('worldsim_keyboard')
    pub = node.create_publisher(String, '/worldsim/key', 10)
    reset = node.create_publisher(Empty, '/worldsim/reset', 1)
    print('Task keys: arm 0 J/L I/K U/O, arm 1 A/D W/S Q/E (each task uses its own subset). H toggles a supported '
          'gripper. R resets, X quits. Hold a key to repeat.', flush=True)
    attrs = termios.tcgetattr(sys.stdin)
    try:
        tty.setcbreak(sys.stdin.fileno())
        while rclpy.ok():
            rclpy.spin_once(node, timeout_sec=0.03)
            if not select.select([sys.stdin], [], [], 0)[0]:
                continue
            key = sys.stdin.read(1).lower()
            if key == 'x':
                break
            if key == 'r':
                reset.publish(Empty())
            elif key in 'jlikuoadwsqeh':
                pub.publish(String(data=key))
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, attrs)
        node.destroy_node()
        rclpy.try_shutdown()

if __name__ == '__main__':
    main()
